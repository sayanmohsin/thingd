{
  "name": "thingd-repo",
  "version": "0.1.0",
  "private": true,
  "author": "Sayan Mohsin",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "bench:rust": "cargo run --release -p thingd-core --example storage_bench --features sqlite",
    "bench:rust:smoke": "cargo run --release -p thingd-core --example storage_bench --features sqlite -- 100",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "rust:check": "cargo check --workspace --all-targets --all-features",
    "rust:clippy": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "rust:fmt": "cargo fmt --all",
    "rust:fmt:check": "cargo fmt --all --check",
    "serve:mcp": "node packages/thingd-cli/dist/index.js mcp-http",
    "smoke:docker": "bash scripts/smoke-docker.sh",
    "cli": "node packages/thingd-cli/dist/index.js",
    "test": "pnpm test:node && pnpm test:cli && pnpm test:package && pnpm test:rust",
    "test:cli": "pnpm --filter thingd-cli test",
    "test:local": "pnpm check && pnpm build && pnpm test:node && pnpm test:cli && pnpm test:package",
    "test:mcp": "pnpm --filter thingd-cli test",
    "test:node": "pnpm --filter thingd test",
    "examples": "pnpm --filter \"thingd-node-basic-example\" start && pnpm --filter \"thingd-node-stream-example\" start && pnpm --filter \"thingd-node-queue-example\" start",
    "examples:load": "pnpm --filter \"thingd-node-load-example\" start",
    "test:package": "pnpm --filter thingd build && node scripts/verify-package.mjs",
    "test:rust": "cargo test --workspace --all-targets --all-features"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@biomejs/biome": "2.4.16",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "12.0.8",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "25.9.1",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "cross-spawn": "^7.0.6",
    "semantic-release": "25.0.3",
    "thingd-native": "file:packages/thingd-native",
    "typescript": "6.0.3"
  }
}
