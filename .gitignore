dist/
packages/thingd-native/prebuilds/

# ── Package manager ──
.pnpm-store/
package-lock.json
yarn.lock

# ── macOS metadata ──
.DS_Store

# ── Editor and IDE ──
.idea/
.vscode/
.kilo/
*.swp
*.swo

# ── Logs ──
*.log

