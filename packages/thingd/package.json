{
  "name": "@thingd/sdk",
  "version": "0.67.2",
  "description": "A fast object-first data engine for applications and AI agents.",
  "type": "module",
  "author": "Sayan Mohsin",
  "license": "Apache-2.0",
  "homepage": "https://engine.thingd.cloud",
  "bugs": {
    "url": "https://github.com/sayanmohsin/thingd/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "mcp",
    "mcp-server",
    "mcp-database",
    "memory",
    "queue",
    "durable-queues",
    "fjall",
    "rust",
    "local-first",
    "data-engine",
    "object-store",
    "embedded-database",
    "ai-memory",
    "local-database",
    "full-text-search",
    "event-stream"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sayanmohsin/thingd.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "require": "./dist/client/index.js"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "import": "./dist/memory/index.js",
      "require": "./dist/memory/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.js"
    },
    "./browser": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "require": "./dist/client/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@thingd/native": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
