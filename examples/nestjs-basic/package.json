{
  "name": "thingd-nestjs-basic-example",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "pnpm build && node dist/main.js",
    "start:dev": "pnpm build && concurrently -k \"tsc --watch -p tsconfig.json\" \"node --watch dist/main.js\"",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.2",
    "@nestjs/core": "^12.6.2",
    "@nestjs/platform-express": "^12.6.2",
    "@thingd/sdk": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@types/node": "26.6.10",
    "concurrently": "^10.0.7",
    "typescript": "7.0.2",
    "webpack": "5.113.0"
  }
}
